# Copy to .env — never commit .env
# Postgres (docker compose, step 2)
DATABASE_URL=postgres://deskpilot:deskpilot@localhost:5432/deskpilot
# Web -> worker
WORKER_URL=http://localhost:4000
WORKER_SECRET=change-me-dev-secret
WORKER_PORT=4000
# AI provider: "mock" is free and the default. Real providers need explicit approval.
LLM_PROVIDER=mock

# Signs the mock login cookie (dev only). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-dev-session-secret
